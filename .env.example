# Environment Configuration for arXiv Combinatorics Frontend
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# Database Configuration
DB_HOST=localhost
DB_USER=arxiv_user
DB_PASSWORD=your-strong-password-here
DB_NAME=arxiv_frontend
DB_CHARSET=utf8mb4

# Flask Configuration
FLASK_SECRET_KEY=generate-with-python-secrets-token-hex-32
FLASK_DEBUG=False
PREFERRED_URL_SCHEME=https

# Administrative and cron credentials
ADMIN_PASSWORD=choose-a-separate-strong-admin-password
ADMIN_ORCID=
FETCH_SECRET=generate-with-python-secrets-token-hex-32

# Optional arXiv metadata backoff after 429 or transient server failures.
ARXIV_RETRY_DELAYS=30,120,600

# Optional admin-banner threshold for papers awaiting automated DOI checks.
DOI_BACKLOG_WARNING=1000

# Optional persistent cache path for symmetricfunctions.com site labels.
# Defaults to ~/.cache/arxiv-symmetricfunctions/site-labels.json.
# SF_LABEL_CACHE_PATH=/absolute/path/to/site-labels.json

# Production Settings
# For production, FLASK_DEBUG should be False
# Generate secret key with: python3 -c "import secrets; print(secrets.token_hex(32))"

# ORCID OAuth (for user login)
# Register your app at https://orcid.org/developer-tools
# Redirect URI to register: https://arxiv.symmetricfunctions.com/login/orcid/callback
ORCID_CLIENT_ID=your-orcid-client-id
ORCID_CLIENT_SECRET=your-orcid-client-secret
